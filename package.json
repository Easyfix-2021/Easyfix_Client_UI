{
  "name": "easyfix-client-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 5181",
    "build": "npm run brand:verify && npm run check:brand && next build",
    "start": "next start -p 5181",
    "typecheck": "tsc --noEmit",
    "brand:gen": "node scripts/gen-brand-css.mjs",
    "brand:verify": "node scripts/gen-brand-css.mjs --verify",
    "check:brand": "node scripts/check-brand-tokens.js",
    "test:build": "tsc src/lib/format.ts src/lib/sweeps.ts --outDir .test-build --rootDir src/lib --module commonjs --target es2020 --skipLibCheck",
    "test": "npm run test:build && node --test tests/*.test.js"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.453.0",
    "next": "^15.5.15",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.3"
  }
}
