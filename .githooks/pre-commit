#!/bin/sh
# Lockfile-sync guard. Fast, staged-tree only: it never installs, never runs a
# build, never touches the network beyond npm's own metadata cache.
#
# WHY. `npm ci` refuses a tree whose package.json and package-lock.json
# disagree, and CI takes that path. Local `npm run build` and `npm test` do NOT
# catch it, because node_modules is already populated on a developer machine —
# so drift ships green, and dies on the runner at the install step before a
# single test runs. That is exactly how it happened on 2026-08-27: adding the
# vitest devDependencies left the lock pinning esbuild 0.21.5 against a
# package.json resolving 0.28.2.
#
# COST. `npm ci --dry-run` performs that same validation and STOPS — measured
# at ~0.5s, and only when a manifest is actually staged. A commit that touches
# neither file pays nothing.
#
# Deliberately not `npm ci`: the real thing deletes node_modules and reinstalls,
# which is a minute of a developer's attention on every commit, and would be
# turned off within a day.

set -eu

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Only when a manifest is in the staged set. --diff-filter=d skips deletions:
# a commit removing package-lock.json has nothing to validate against.
STAGED="$(git diff --cached --name-only --diff-filter=d)"
case "$STAGED" in
  *package.json*|*package-lock.json*) ;;
  *) exit 0 ;;
esac

printf 'pre-commit: package manifest staged — checking lockfile sync… '

if npm ci --dry-run >/tmp/easyfix-lockcheck.$$ 2>&1; then
  rm -f "/tmp/easyfix-lockcheck.$$"
  printf 'in sync\n'
  exit 0
fi

printf 'OUT OF SYNC\n\n'
# Only the lines naming an actual mismatch. npm follows its error with a full
# usage dump, which buries the one thing the reader needs.
grep -E 'Invalid:|Missing:|Extraneous:|are in sync' "/tmp/easyfix-lockcheck.$$" | head -8 || true
rm -f "/tmp/easyfix-lockcheck.$$"
cat <<'MSG'

  package.json and package-lock.json disagree, so `npm ci` will fail — and CI
  runs `npm ci` before anything else, so this would break the build on the
  runner rather than here.

  Fix:   npm install && git add package-lock.json
  Skip:  git commit --no-verify   (CI still runs npm ci, so this only defers it)

MSG
exit 1
